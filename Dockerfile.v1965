FROM --platform=$BUILDPLATFORM node:22-alpine AS build
WORKDIR /app
ENV HUSKY=0
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund
COPY . .
RUN node --max_old_space_size=6000 ./node_modules/@angular/cli/bin/ng build --configuration production

FROM nginx:stable-alpine AS runtime
LABEL org.opencontainers.image.version="19.1.65"
ENV COLTON_API_TARGET=http://apigateway:5555 \
    MES_ITEM_IMPORT_TARGET=http://mes-item-import:18793 \
    MES_WORK_ORDER_IMPORT_TARGET=http://mes-work-order-import:18792 \
    MES_ITEM_SETTINGS_TARGET=http://mes-item-settings:18790 \
    MES_INVENTORY_HANDOFF_TARGET=http://mes-inventory-handoff:18791 \
    ADMINER_TARGET=http://adminer:8080
COPY deploy/colton/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist/ng-alain-v19-without-ssr/browser/ /usr/share/nginx/html/
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
