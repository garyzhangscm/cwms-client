server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 50m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location = /index.html {
        add_header Cache-Control 'no-cache';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/inventory-handoff/ {
        proxy_pass ${MES_INVENTORY_HANDOFF_TARGET}/inventory-handoff/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    location /api/integration-settings/ {
        proxy_pass ${MES_ITEM_SETTINGS_TARGET}/integration-settings/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    location /api/ {
        # Forward the normalized URI, including legacy clients' duplicate slashes.
        proxy_pass ${COLTON_API_TARGET}/api/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    location /adminer/ {
        proxy_pass ${ADMINER_TARGET};
    }
}
